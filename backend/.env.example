# Copia este archivo a .env (junto a config.yaml). .env NO se versiona.
# Estas variables pisan lo que diga config.yaml; las del entorno real pisan a estas.

# --- Bases de datos ---
# PostgreSQL: URL o pares clave=valor. No sirve el formato de Npgsql (Host=..;Port=..).
CONNECTIONSTRINGS_POSTGRESQL=host=localhost port=5432 dbname=hoteleria user=postgres password=CAMBIAR
CONNECTIONSTRINGS_REDIS=localhost:6379
CONNECTIONSTRINGS_MONGODB=mongodb://localhost:27017
MONGODBSETTINGS_DATABASENAME=hoteleria_logs

# --- Seguridad ---
# Mínimo 32 bytes. Genera una con: openssl rand -base64 48
JWTSETTINGS_SECRETKEY=CAMBIAR_POR_UNA_CLAVE_LARGA_Y_ALEATORIA_DE_AL_MENOS_32_BYTES
JWTSETTINGS_ISSUER=Hoteleria
JWTSETTINGS_AUDIENCE=HoteleriaClient
JWTSETTINGS_EXPIRATIONHOURS=8

# --- Super administrador inicial ---
# Se crea una sola vez al arrancar, si no existe. Minimo 10 caracteres.
# Sin esto no se crea ningun usuario (no hay contrasena por defecto).
ADMININICIAL_EMAIL=admin@hotelerias.test
ADMININICIAL_PASSWORD=CAMBIAR_MINIMO_10_CARACTERES

# --- Datos de muestra del portal ---
# true: siembra sedes, habitaciones, tipos de cliente y ofertas para recorrer la web.
# Solo siembra si todavia no hay ninguna sede. Dejarlo en false en produccion.
DEMO_DATOS=false

# --- Servicios externos ---
APISPERU_TOKEN=CAMBIAR

# --- Servidor ---
SERVER_PORT=5220
SERVER_UPLOADSDIR=uploads
